# Dispositions for vcore-encodings.allium's `allium plan` obligations.
# test:<name> entries resolve against tests/vcore-encodings/ (the shell
# functions in run-vcore-encodings-tests.sh); `structural` marks the
# obligations the spec's own check/analyse lane discharges. Run with:
#   host-lifecycle obligations src/drivers/i2c/isl6367/vcore-encodings.allium \
#       --tests tests/vcore-encodings --strict-discharge

# The encoding contracts and their register programs.
value-equality.RegisterProgram => test:theft_offset_program exercises=isl6367_encode_offset
entity-fields.RegisterProgram => structural
value-equality.LlcProgram => test:theft_llc_levels exercises=isl6367_encode_llc
entity-fields.LlcProgram => structural
contract-signature.OffsetEncoding.encode => test:theft_offset_program exercises=isl6367_encode_offset
contract-signature.FixedEncoding.encode => test:theft_fixed_program exercises=isl6367_encode_fixed
contract-signature.LoadLineEncoding.encode => test:theft_llc_levels exercises=isl6367_encode_llc

# The request lifecycle and graph shape: the driver has no runtime
# request path (the devicetree is the request source), so the
# lifecycle obligations ride the spec's own lane.
enum-comparable.VcoreSource => structural
when-presence.VcoreRequest.resolved_mv => structural
when-presence.VcoreRequest.program => structural
transition-edge.VcoreRequest.requested.resolved => test:theft_offset_span exercises=isl6367_encode_offset
transition-edge.VcoreRequest.resolved.programmed => test:theft_offset_program exercises=isl6367_encode_offset
transition-edge.VcoreRequest.resolved.refused => test:theft_fixed_span exercises=isl6367_encode_fixed
transition-rejected.VcoreRequest.state => structural
transition-terminal.VcoreRequest.state => structural
entity-fields.VcoreRequest => structural
entity-fields.LoadLineSetting => structural
rule-success.RequestRecorded => test:theft_offset_program exercises=isl6367_encode_offset
rule-entity-creation.RequestRecorded.1 => test:theft_offset_program exercises=isl6367_encode_offset

# The resolve and refuse rules against the encoders span guards.
rule-success.OffsetRequestResolved => test:theft_offset_span exercises=isl6367_encode_offset
rule-failure.OffsetRequestResolved.1 => test:theft_offset_span exercises=isl6367_encode_offset
rule-failure.OffsetRequestResolved.2 => test:theft_offset_span exercises=isl6367_encode_offset
rule-failure.OffsetRequestResolved.3 => test:theft_offset_span exercises=isl6367_encode_offset
rule-success.OffsetRequestRefused => test:theft_offset_span exercises=isl6367_encode_offset
rule-failure.OffsetRequestRefused.1 => test:theft_offset_span exercises=isl6367_encode_offset
rule-failure.OffsetRequestRefused.2 => test:theft_offset_span exercises=isl6367_encode_offset
rule-failure.OffsetRequestRefused.3 => test:theft_offset_span exercises=isl6367_encode_offset
rule-success.FixedRequestResolved => test:theft_fixed_span exercises=isl6367_encode_fixed
rule-failure.FixedRequestResolved.1 => test:theft_fixed_span exercises=isl6367_encode_fixed
rule-failure.FixedRequestResolved.2 => test:theft_fixed_span exercises=isl6367_encode_fixed
rule-failure.FixedRequestResolved.3 => test:theft_fixed_span exercises=isl6367_encode_fixed
rule-success.FixedRequestRefused => test:theft_fixed_span exercises=isl6367_encode_fixed
rule-failure.FixedRequestRefused.1 => test:theft_fixed_span exercises=isl6367_encode_fixed
rule-failure.FixedRequestRefused.2 => test:theft_fixed_span exercises=isl6367_encode_fixed
rule-failure.FixedRequestRefused.3 => test:theft_fixed_span exercises=isl6367_encode_fixed

# The program rules.
rule-success.OffsetProgrammed => test:theft_offset_program exercises=isl6367_encode_offset
rule-failure.OffsetProgrammed.1 => test:theft_fixed_program exercises=isl6367_encode_fixed
rule-success.FixedProgrammed => test:theft_fixed_program exercises=isl6367_encode_fixed
rule-failure.FixedProgrammed.1 => test:theft_offset_program exercises=isl6367_encode_offset
rule-success.LoadLineProgrammed => test:theft_llc_levels exercises=isl6367_encode_llc
rule-failure.LoadLineProgrammed.1 => test:theft_llc_levels exercises=isl6367_encode_llc
rule-entity-creation.LoadLineProgrammed.1 => test:theft_llc_levels exercises=isl6367_encode_llc

# The MSR 0x150 mailbox layout.
invariant.MailboxTransaction.CmdIsVoltageFreqOverride => test:theft_mailbox_words exercises=oc_mailbox_interface_word,oc_mailbox_data_word
invariant.MailboxTransaction.PlaneWithinRange => test:theft_mailbox_words exercises=oc_mailbox_interface_word,oc_mailbox_data_word
invariant.MailboxTransaction.RunBusyIsBit => test:theft_mailbox_words exercises=oc_mailbox_interface_word,oc_mailbox_data_word
invariant.MailboxTransaction.OffsetWithinCap => test:theft_mailbox_words exercises=oc_mailbox_interface_word,oc_mailbox_data_word
invariant.MailboxTransaction.ModeIsBit => test:theft_mailbox_words exercises=oc_mailbox_interface_word,oc_mailbox_data_word
invariant.MailboxTransaction.TargetWithinWidth => test:theft_mailbox_words exercises=oc_mailbox_interface_word,oc_mailbox_data_word
invariant.MailboxTransaction.RatioWithinWidth => test:theft_mailbox_words exercises=oc_mailbox_interface_word,oc_mailbox_data_word
entity-fields.MailboxTransaction => test:theft_mailbox_words exercises=oc_mailbox_interface_word,oc_mailbox_data_word
derived.MailboxTransaction.interface_word => test:theft_mailbox_words exercises=oc_mailbox_interface_word,oc_mailbox_data_word
derived.MailboxTransaction.data_word => test:theft_mailbox_words exercises=oc_mailbox_interface_word,oc_mailbox_data_word
rule-success.MailboxTransactionRecorded => test:theft_mailbox_words exercises=oc_mailbox_interface_word,oc_mailbox_data_word
rule-entity-creation.MailboxTransactionRecorded.1 => test:theft_mailbox_words exercises=oc_mailbox_interface_word,oc_mailbox_data_word

