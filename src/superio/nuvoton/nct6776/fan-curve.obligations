# Dispositions for fan-curve.allium's `allium plan` obligations.
# test:<name> entries resolve against tests/fan-curve/ (the shell functions
# in run-fan-curve-tests.sh); `structural` marks the obligations the spec's
# own check/analyse lane discharges. Run with:
#   host-lifecycle obligations src/superio/nuvoton/nct6776/fan-curve.allium \
#       --tests tests/fan-curve --strict-discharge

# The encoding contracts and their register programs.
value-equality.FanProgram => test:theft_fan_program exercises=fan_curve_encode_sf4
entity-fields.FanProgram => structural
contract-signature.CurveEncoding.encode => test:theft_fan_program exercises=fan_curve_encode_sf4
contract-signature.SlewEncoding.encode => test:theft_fan_slew exercises=fan_curve_encode_sf4,fan_curve_slew_safe
contract-signature.SourceAddressing.source_reg => test:theft_fan_source exercises=fan_curve_source_reg,NCT6776_SOURCE_COUNT

# The request lifecycle and graph shape: the driver has no runtime
# request path (the devicetree is the request source), so the
# lifecycle obligations ride the spec's own lane.
enum-comparable.TempSource => structural
when-presence.FanCurveRequest.program => structural
transition-edge.FanCurveRequest.requested.resolved => test:theft_fan_span exercises=fan_curve_encode_sf4
transition-edge.FanCurveRequest.requested.refused => test:theft_fan_span exercises=fan_curve_encode_sf4
transition-edge.FanCurveRequest.resolved.programmed => test:theft_fan_program exercises=fan_curve_encode_sf4
transition-rejected.FanCurveRequest.state => structural
transition-terminal.FanCurveRequest.state => structural
entity-fields.FanCurveRequest => structural

# The config defaults and the spec-level invariants, cross-checked
# against the encoder header and the design policy. The bank-target and
# fan-mode register offsets are not config parameters (the cruise
# fallback is coarse in this spec); the source count rides the source
# property.
config-default.floor_min_duty => test:config_defaults_match_spec exercises=NCT6776_SF4_POINTS,NCT6776_DUTY_MAX,NCT6776_TEMP_MAX_C,NCT6776_TICKS_MAX,NCT6776_TICK_MS,NCT6776_MODE_MANUAL,NCT6776_MODE_THERMAL_CRUISE,NCT6776_MODE_SPEED_CRUISE,NCT6776_MODE_SF4,NCT6776_REG_BANK_STEP_UP,NCT6776_REG_BANK_STEP_DOWN,NCT6776_REG_BANK_AUTO_TEMP,NCT6776_REG_BANK_AUTO_PWM,NCT6776_REG_BANK_CRITICAL_TEMP,NCT6776_REG_SOURCE_BASE,NCT6776_FLOOR_MIN_DUTY,NCT6776_STEP_UP_TICKS_DEFAULT,NCT6776_STEP_DOWN_TICKS_DEFAULT,NCT6776_KNEE_TEMP_C_DEFAULT,NCT6776_FULL_TEMP_C_DEFAULT,NCT6776_CRITICAL_TEMP_C_DEFAULT,NCT6776_SOURCE_CPUTIN
